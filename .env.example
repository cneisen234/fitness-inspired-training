# ---------------------------------------------------------------------------
# Fitness Inspired Training — contact form configuration.
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; never commit real keys. In production, set these in your host
# (e.g. Vercel Project Settings → Environment Variables).
# ---------------------------------------------------------------------------

# --- Google reCAPTCHA v3 ---
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3").
# The SITE key is public (shipped to the browser); the SECRET key is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Reject submissions scoring below this (0.0 = bot, 1.0 = human). Default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# --- Twilio SendGrid (email delivery) ---
# Create a key at https://app.sendgrid.com → Settings → API Keys (Mail Send).
SENDGRID_API_KEY=
# Where submissions are delivered — Ashley's inbox.
CONTACT_TO_EMAIL=
# The "from" address. MUST be a verified Sender / authenticated domain in SendGrid.
CONTACT_FROM_EMAIL=

# ===========================================================================
# Admin portal (blog + reviews). Added in Step 0 of the build plan.
# ===========================================================================

# --- Postgres (Vercel Postgres / Neon) ---
# DATABASE_URL is the POOLED connection string (host contains "-pooler"); the app
# uses it at runtime. POSTGRES_URL_NON_POOLING is the DIRECT string; drizzle-kit
# migrations use it. Vercel injects both when you add the Postgres integration —
# for local dev, copy them from the Vercel project's Storage tab.
DATABASE_URL=
POSTGRES_URL_NON_POOLING=

# --- Admin auth (single admin — Ashley, no registration) ---
# AUTH_SECRET: random 32+ byte secret used to sign the session cookie.
#   Generate: openssl rand -base64 32
# ADMIN_PASSWORD_HASH: base64-encoded bcrypt hash of the one admin password
#   (base64 so it has no `$`, which Next.js would otherwise expand and corrupt).
#   Generate: npm run admin:hash   (prompts securely; copy the printed line)
AUTH_SECRET=
ADMIN_PASSWORD_HASH=

# --- UploadThing (blog images) ---
# From uploadthing.com → your app → API Keys. One token for the current SDK.
# Required for the /api/uploadthing endpoint (cover + inline blog images).
UPLOADTHING_TOKEN=

# ===========================================================================
# Stripe — one-time workout-plan purchases (Phase 2). Use TEST keys while
# building (sk_test_… / pk_test_…); swap to live keys at launch.
# ===========================================================================

# Server-only secret key. dashboard.stripe.com → Developers → API keys (Test mode).
STRIPE_SECRET_KEY=
# Publishable key — safe to ship to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public base URL used to build Stripe Checkout success/cancel return links.
# Local dev: http://localhost:3000 — in production, the live site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Webhook signing secret (set in Step 9). Local dev: from `stripe listen`
# (starts with whsec_…); production: Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=
